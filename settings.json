  "editor.lineNumbers": "relative",
  "editor.wordWrap": "bounded",
  "editor.wordWrapColumn": 120,
  "editor.renderLineHighlight": "none",
  "editor.guides.indentation": true,
  "editor.inlayHints.enabled": "on",
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "dance.modes": {
    "helix/insert": {
      "lineNumbers": "relative",
      "onLeaveMode": [
        [
          ".selections.save",
          {
            "register": " insert"
          }
        ]
      ],
      "cursorStyle": "line"
    },
    "helix/select": {
      "lineNumbers": "relative",
      "cursorStyle": "underline",
      "selectionBehavior": "character"
    },
    "helix/normal": {
      "lineNumbers": "relative",
      "cursorStyle": "block",
      "selectionBehavior": "character",
      "decorations": {},
      "onEnterMode": [
        [
          ".selections.restore",
          {
            "register": " ^",
            "try": true
          }
        ]
      ],
      "onLeaveMode": [
        [
          ".selections.save",
          {
            "register": " ^",
            "style": {
              "borderColor": "$editor.selectionBackground",
              "borderStyle": "solid",
              "borderWidth": "2px",
              "borderRadius": "1px"
            },
            "until": [
              [
                "mode-did-change",
                {
                  "include": "normal"
                }
              ],
              [
                "selections-did-change"
              ]
            ]
          }
        ]
      ]
    }
  },
  "editor.minimap.enabled": false,
  "breadcrumbs.enabled": false,
  "workbench.activityBar.location": "hidden",
  "workbench.editor.showTabs": "none",
  "workbench.editor.enablePreview": false,
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "workbench.startupEditor": "none",
  "window.restoreWindows": "none",
  "extensions.experimental.affinity": {
    "gregoire.dance": 1,
    "gregoire.dance-helix": 1,
    "sio.helix-workbench": 1
  },
  "workbench.editor.restoreEditors": false,
  "terminal.integrated.enablePersistentSessions": false,
  "files.hotExit": "off",
  "helixWorkbench.dashboard.showOnStartup": true,
  "workbench.tips.enabled": false,
  "workbench.list.defaultFindMode": "filter",
  "workbench.list.typeNavigationMode": "trigger",
  "workbench.editor.revealIfOpen": false,
  "workbench.editor.closeEmptyGroups": false,
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.formatterPath": "alejandra",
  "nix.serverSettings": {
    "nixd": {
      "formatting": {
        "command": [
          "alejandra"
        ]
      }
    }
  },
  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide"
  },
  "shellformat.path": "shfmt",
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  "terminal.integrated.defaultLocation": "editor",
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "terminal.integrated.hideOnStartup": "always",
  "terminal.integrated.allowChords": false,
  "terminal.integrated.sendKeybindingsToShell": true,
  "terminal.integrated.allowMnemonics": false,
  "terminal.integrated.commandsToSkipShell": [
    "sio.buffers.pick",
    "sio.buffers.next",
    "sio.buffers.previous",
    "sio.buffers.close",
    "sio.panes.close",
    "sio.panes.only",
    "sio.terminals.open"
  ],
  "workbench.colorTheme": "NoctaliaTheme",
  "editor.fontFamily": "'DMMono Nerd Font Mono', monospace",
  "editor.fontSize": 16,
  "terminal.integrated.fontFamily": "DMMono Nerd Font Mono",
  "terminal.integrated.fontSize": 16,
  "telemetry.feedback.enabled": false,
